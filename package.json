{
  "name": "when-controls-raise-the-cost",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-dataset.mjs && vinext build",
    "build:data": "node scripts/build-dataset.mjs",
    "check:data": "node scripts/build-dataset.mjs --check",
    "check:schema": "node scripts/validate-data.mjs --schema",
    "check:citations": "node scripts/validate-data.mjs --citations",
    "check:links": "node scripts/check-links.mjs",
    "audit:sources": "node scripts/capture-audit-sources.mjs",
    "audit:evidence": "node scripts/audit-evidence.mjs",
    "test": "node --experimental-strip-types --test",
    "test:browser": "playwright test --grep-invert @screenshot",
    "test:browser:local": "PLAYWRIGHT_BASE_URL=http://localhost:3001 PLAYWRIGHT_USE_SYSTEM_CHROME=1 playwright test --grep-invert @screenshot",
    "test:screenshots": "playwright test --grep @screenshot",
    "test:screenshots:local": "PLAYWRIGHT_BASE_URL=http://localhost:3001 PLAYWRIGHT_USE_SYSTEM_CHROME=1 playwright test --grep @screenshot",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "verify": "pnpm check:schema && pnpm check:citations && pnpm test && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
